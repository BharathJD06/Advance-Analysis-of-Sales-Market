      </column>
      <column caption='Profit' datatype='integer' name='[Calculation_1634525197146206215]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1634525197143109633]-[Calculation_1634525197146148870]' />
      </column>
      <column caption='Profit Ratio' datatype='real' name='[Calculation_1634525197146333192]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1634525197146206215]/[Calculation_1634525197143109633]' />
      </column>
      <column caption='Channel Distribution' datatype='real' name='[Calculation_1634525197146472458]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1634525197143109633]) / TOTAL(SUM([Calculation_1634525197143109633]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Top 5' datatype='integer' name='[Calculation_1634525197149954060]' role='measure' type='quantitative'>
