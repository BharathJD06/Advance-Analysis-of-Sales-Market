      <column caption='Sales' datatype='integer' name='[Calculation_1634525197143109633]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[UnitsSold]*[UnitPrice]' />
      </column>
      <column caption='Sales Growth %' datatype='real' name='[Calculation_1634525197143580674]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Calculation_1634525197143109633]) - LOOKUP(SUM([Calculation_1634525197143109633]), -1)) / LOOKUP(SUM([Calculation_1634525197143109633]), -1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Market Share' datatype='real' name='[Calculation_1634525197143638019]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1634525197143109633]) / TOTAL(SUM([Calculation_1634525197143109633]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Cost' datatype='integer' name='[Calculation_1634525197146148870]' role='measure' type='quantitative'>
